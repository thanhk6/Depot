	"info": {
		"_postman_id": "32e80d97-3efa-4f0e-8e6a-bbf22e36d6a6",
		"name": "AEMS API Integration",
		"description": "**Initial steps before running scripts**\n\n1. Set the `Client ID`, `Client Secret`, `Consumer-Key` and `maintenanceShopCode` in postman collection variables.\n    \n2. Run `get-authentication-token` which will use the configured variable to get and set the authentication token in variables, avaiable for two hours.\n    \n\nAfter this feel free to update the body content of any script in this collection and play around in AEMS APIs.\n\nNote: Please read the OAS to get wiser on the required body content and return types!",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "33422012"
	},
	"item": [
		{
			"name": "get-authentication-token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.collectionVariables.set(\"access_token\", jsonData.access_token);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Consumer-Key",
						"value": "{{consumer_key}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded",
						"type": "text"
					},
					{
						"key": "Cache-Control",
						"value": "no-cache",
						"type": "text"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "grant_type",
							"value": "client_credentials",
							"type": "text"
						},
						{
							"key": "client_id",
							"value": "{{consumer_key}}",
							"type": "text"
						},
						{
							"key": "client_secret",
							"value": "{{client_secret}}",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "https://api-stage.maersk.com/customer-identity/oauth/v2/access_token",
					"protocol": "https",
					"host": [
						"api-stage",
						"maersk",
						"com"
					],
					"path": [
						"customer-identity",
						"oauth",
						"v2",
						"access_token"
					]
				},
				"description": "Gets the _access_token_ from Maersk Oauth2 Authentication API.\n\nSets the _access_token_ as a local collection variable, which will be used in all the other API calls.\n\nTokeb wll be valid for 2 hours."
			},
			"response": []
		},
