using System;
using Microsoft.AspNetCore.Builder;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using System.Text.Json.Serialization;
using Depot.Data.EF;
using Depot.Application.Services;

var builder = WebApplication.CreateBuilder(args);

// Composition root: chỉ đăng ký dependency và middleware; business rule nằm ở Application.
// SQL Server là database chính, không dùng InMemory khi chạy ứng dụng.
var useSqlServer = builder.Configuration.GetValue<bool?>("UseSqlServer") ?? true;
var connectionString = builder.Configuration.GetConnectionString("SqlServerConnection");

builder.Services.AddDbContext<DepotDbContext>(options =>
{
    if (useSqlServer)
    {
        if (string.IsNullOrWhiteSpace(connectionString))
            throw new InvalidOperationException("ConnectionStrings:SqlServerConnection chưa được cấu hình.");

        // Retry giúp ứng dụng chịu được SQL Server khởi động chậm hoặc mạng chập chờn.
        options.UseSqlServer(connectionString, sqlOptions =>
        {
            sqlOptions.MigrationsAssembly("Depot.Data");
            sqlOptions.EnableRetryOnFailure(maxRetryCount: 5, maxRetryDelay: TimeSpan.FromSeconds(10), errorNumbersToAdd: null);
        });
    }
    else
    {
        throw new InvalidOperationException("Backend đang yêu cầu SQL Server. Chỉ bật UseSqlServer=false khi chạy test riêng.");
    }
});

// Register Application Services: Controller phụ thuộc interface, dễ thay implementation khi tích hợp thật.
builder.Services.AddScoped<IUserService, UserService>();
builder.Services.AddScoped<IDepotJobService, DepotJobService>();
builder.Services.AddScoped<IYardService, YardService>();
builder.Services.AddScoped<IMasterDataService, MasterDataService>();
builder.Services.AddScoped<IShippingIntegrationService, ShippingIntegrationService>();
builder.Services.AddScoped<INotificationService, NotificationService>();
builder.Services.AddScoped<IWarehouseService, WarehouseService>();

builder.Services.AddControllers()
    .AddJsonOptions(options =>
    {
        options.JsonSerializerOptions.ReferenceHandler = ReferenceHandler.IgnoreCycles;
    });
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();

// Frontend dev server :3000 cần gọi API :50210 trong local development.
builder.Services.AddCors(options =>
{
    options.AddPolicy("AllowAll", p =>
        p.AllowAnyOrigin().AllowAnyMethod().AllowAnyHeader());
});

var app = builder.Build();

app.UseSwagger();
app.UseSwaggerUI(options =>
{
    options.DocumentTitle = "Depot Backend API";
    options.RoutePrefix = "swagger";
});

app.UseCors("AllowAll");
app.UseAuthorization();

app.MapGet("/", () => Results.Redirect("/swagger"));
app.MapGet("/api/health", () => Results.Ok(new
{
    statusCode = 200,
    status = "ONLINE",
    backendService = "SolutionDepot API",
    database = "SQL Server",
    timestamp = DateTime.UtcNow
}));
app.MapControllers();

// Migration và seed phải hoàn tất trước khi API nhận request đầu tiên.
using (var scope = app.Services.CreateScope())
{
    var dbContext = scope.ServiceProvider.GetRequiredService<DepotDbContext>();
    await DbInitializer.InitializeAsync(dbContext);
}

app.Run();
