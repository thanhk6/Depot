# Mẫu file .env cho docker-compose.vps.yml — sao chép thành .env rồi điền giá trị thật.
DOCKERHUB_USER=thanhnguyenit89
TAG=latest

# PostgreSQL cài trực tiếp trên VPS
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=SolutionDepotDb
DB_USER=depot_user
DB_PASSWORD=change_me

# Secret dùng chung với cổng thanh toán/ngân hàng để xác thực webhook
WEBHOOK_SECRET=change_me

# Key ký JWT — sinh bằng: openssl rand -hex 32  (KHÔNG dùng lại key ở môi trường khác)
JWT_KEY=change_me_openssl_rand_hex_32

# Mật khẩu ban đầu của tài khoản seed (≥8 ký tự, nên có hoa/số/ký tự đặc biệt)
SEED_DEFAULT_PASSWORD=change_me

# Cổng công khai của frontend và cổng nội bộ (127.0.0.1) của backend
FRONTEND_PORT=3001
BACKEND_PORT=50210

# Depot.FileServer (lưu ảnh) — cổng nội bộ 127.0.0.1 và thư mục lưu file trên VPS (nhớ backup)
FILESERVER_PORT=50211
FILE_STORAGE_PATH=/opt/depot/storage-files
FILE_MAX_SIZE_BYTES=20971520
