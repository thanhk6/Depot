# Chép thành tests/.env rồi điền giá trị máy local (tests/.env không đưa lên Git).
# Bộ test CHỈ chạy trên local: mọi địa chỉ phải là 127.0.0.1 / localhost, nếu không sẽ dừng ngay.

# Frontend local (tự chuyển /api sang backend :50210)
TEST_BASE_URL=http://127.0.0.1:3000

# Tài khoản admin local dùng để chạy test (tài khoản tạm do test tạo cũng dùng mật khẩu này)
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=

# PostgreSQL local — chỉ dùng để tạo tài khoản tạm và dọn dữ liệu test (tiền tố QATS / qa_t_ / QA_T_)
TEST_DB_URL=postgres://postgres:<mat-khau>@127.0.0.1:5432/SolutionDepotDb
